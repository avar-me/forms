{
  "ани": {
    "wordform": "ани",
    "sources": {
      "gimbatov": {
        "id": "gimbatov",
        "name": "AV-RU словарь Гимбатова",
        "mentions": [
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "гъвел",
            "av": "мугӏрул гъвелккун ани, батила дуда дир кули",
            "ru": "если пойдёшь по склону горы, попадёшь в мой хутор",
            "sense": "склон горы"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "гӏага-шагарда",
            "av": "гӏага-шагардасан бугеб нухдасан ани, хехго щвела нуж",
            "ru": "если пойдёте по дороге, что внедалеке, вскоре дойдёте",
            "sense": "поблизости, невдалеке"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "гӏин",
            "av": "цояб гӏинзунибе ани, цогидаб гӏинзуниса къватӏибе бачӏуна",
            "ru": "в одно ухо входит, из другого выходит",
            "sense": "ухо"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "дуниял",
            "av": "Гьаб дуниял дир ани, ТӀолго дуе кьелаан, Дунго лагълъун чӏелаан",
            "ru": "Был бы господином вселенной, Её всю подарил бы тебе, А сам стал бы рабом твоим",
            "sense": "мир, свет, вселенная, земля"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "къоно",
            "av": "Лъагӏел тӏубазегӏан росасе ани, ЧӀвайги дида къоно, къайги дий лахӏду",
            "ru": "Если выйду я замуж, пока не будет годовщина смерти, Пусть выроют мне яму, пусть укроют плитой",
            "sense": "плита"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "кӏкӏалахъ",
            "av": "гьаб кӏкӏалахъан ани, гӏурул рагӏалде ккола нуж",
            "ru": "пойдёте по этой балке и доберётесь к берегу реки",
            "sense": "в ущелье, в овраге, в балке"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "манзил",
            "av": "кӏиго версталъул манзилалъ ани, нуж лъарахъе щола",
            "ru": "пройдёте расстояние двух верст, доберётесь до речки",
            "sense": "расстояние; промежуток; перегон"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "нагагь",
            "av": "нагагь мун гьениве ани",
            "ru": "если вдруг ты пойдёшь туда",
            "sense": "неожиданно, внезапно; если вдруг; сверх ожидания"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "рохьоб",
            "av": "унаревила гӏабдал рохьове, ани рохьго къотӏун вачӏуневила",
            "ru": "дурак не соберётся в лес по дрова, а когда отправится, весь лес притащит",
            "sense": "в лесу"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "румаб",
            "av": "Румав парччахӏ дун ани, Тахалда мун телаан, Дунго цеве чӏелаан",
            "ru": "Был бы я римским императором, На трон тебя посадил бы, А сам стал бы слугой твоим",
            "sense": "римский"
          }
        ]
      }
    }
  },
