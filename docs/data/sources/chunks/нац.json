            "av": "богӏода нацӏ барав",
            "ru": "богатый; у кого в ячмени клещи завелись",
            "sense": "злаковые культуры; запас хлеба; хлеб-соль"
          },
          {
            "subsource": "examples",
            "lemma": "нацӏ",
            "pos": "существительное",
            "entry": "кӏалдиб",
            "av": "кӏалдиб нацӏ баниги теларо инсул росу",
            "ru": "хоть с голоду помру, отчий аул не покину",
            "sense": "вложить в уста"
          },
          {
            "subsource": "examples",
            "lemma": "нацӏ",
            "pos": "существительное",
            "entry": "кӏалдиб",
            "av": "кӏалдиб нацӏ барав",
            "ru": "умирающий с голоду, нищенствовующий; тот, у кого во рту завелись вши",
            "sense": "вложить в уста"
          },
          {
            "subsource": "examples",
            "lemma": "нацӏ",
            "pos": "существительное",
            "entry": "нацӏ",
            "av": "нацӏ базе",
            "ru": "(за)вшиветь",
            "sense": "вошь, вша:"
          },
          {
            "subsource": "examples",
            "lemma": "нацӏ",
