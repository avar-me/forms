            "entry": "нацӏ",
            "av": "нацӏ бараб",
            "ru": "вшивый",
            "sense": "вошь, вша:"
          },
          {
            "subsource": "examples",
            "lemma": "нацӏ",
            "pos": "существительное",
            "entry": "нацӏ",
            "av": "нацӏ кӏотинегӏан мехтизе",
            "ru": "напиться, нализаться, хлебнуть через край",
