        "mentions": [
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "анкьабго",
            "av": "Анкьасулго чуги цӏахӏилаб буго",
            "ru": "У всех семерых кони серые",
            "sense": "все семь; все семеро; всемером"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "бодулав",
            "av": "бодуласул ярагъги чуги",
            "ru": "оружие и конь воина",
            "sense": "ратник, ополченец; воин"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "гиризе",
            "av": "гиричӏого гьокоги, бекеричӏого чуги лъалареб",
            "ru": "не узнаёшь арбу, пока не покатится, а коня — пока не поскачет",
            "sense": "(по)катиться, скатиться"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "гъоркь",
            "av": "гъоркь чуги тун, чу балагьизе",
            "ru": "конь под ним, а он коня ищет",
            "sense": "свалить, повалить под себя"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "рихине",
            "av": "Кьилиги рихана, чуги рихана, Чияр улка цӏунун вагъаралдаса",
            "ru": "И седло ненавижу, и к коню отвращение, Как пошёл на войну защищать чужую страну",
            "sense": "ненавидеть, презирать кого-чего-либо; чувствовать, испитывать, питать отвращение, антипатию к кому-чему-либо"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "чукъа",
            "av": "Рекӏине чуги кье, чукъалъунги ккве",
            "ru": "И коня выделите, и в нукеры примите",
            "sense": "челядинец, телохранитель; нукер"
          }
        ]
      }
    }
  },
