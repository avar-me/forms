{
  "ян": {
    "wordform": "ян",
    "sources": {
      "gimbatov": {
        "id": "gimbatov",
        "name": "AV-RU словарь Гимбатова",
        "mentions": [
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "анцӏцӏуса",
            "av": "«чӏа!» — ян абунаха дуда анцӏцӏусаниги",
            "ru": "“уймись” — повторяю тебе десятки раз!",
            "sense": "десятки раз; “"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "воре-гьа",
            "av": "“Воре-гьа!” — ян ахӏулеб букӏана гӏолохъабаз кочӏохъанасде",
            "ru": "молодежь кричала певцу: “Дайте жару!”",
            "sense": "а ну-ка!; дайте жару!"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "воре-гьа",
            "av": "“Воре-гьа!” — ян ворчӏухъанасул ахӏиялъухъе хӏапдезе лъугьана гьаби",
            "ru": "собаки начали лаять, услышав крик ночного караульщика скота: “А нука!”",
            "sense": "а ну-ка!; дайте жару!"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "гьу",
            "av": "“гьу”-- ян абичӏого, ана дов нахъе",
            "ru": "он ушёл, не сказав ни гу-гу",
            "sense": "гу-гу"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "ле",
            "av": "“Ле!” — ян ахӏаниги, ахӏмакъ нахъ вуссунаро",
            "ru": "хоть и покричишь ему “Эй!”, глупец не повернётся к тебе",
            "sense": "эй"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "мархӏаба",
            "av": "«Мархӏаба!» — ян ахӏизе",
            "ru": "кричать: “Браво!”",
            "sense": "браво!; “"
          },
          {
            "subsource": "examples",
            "confidence": "low",
            "entry": "сум-сараялда",
            "av": "херай сум-сараялда ян йиго",
            "ru": "старушка еле жива"
          }
        ]
      }
    }
  },
